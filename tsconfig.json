{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": false,
    "checkJs": false,
    "paths": {
      "@beacon/ble-contracts": ["./packages/ble-contracts/src/index.ts"],
      "@beacon/validation": ["./packages/validation/src/index.ts"],
      "@beacon/protocol-parsers": ["./packages/protocol-parsers/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/tests/**/*.ts",
    "apps/*/tests/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/Pods", "**/build", "**/ios", "**/android"]
}
