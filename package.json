{
  "name": "beacon-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon: cross platform BLE device manager (React Native + Swift + Kotlin)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "typecheck": "tsc --build tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "validate": "yarn typecheck && yarn lint && yarn format:check && yarn test",
    "mobile": "yarn workspace @beacon/mobile"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "sql.js": "1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
